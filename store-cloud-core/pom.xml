<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.store</groupId>
        <artifactId>store-cloud</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 聚合「核心」下各子模块；不在此目录根下直接写 Java 源码 -->
    <artifactId>store-cloud-core</artifactId>
    <packaging>pom</packaging>
    <name>store-cloud-core</name>
    <description>核心能力聚合模块（认证等能力各为子模块）</description>

    <modules>
        <!-- 自下而上：logging / response 为 web 的传递依赖；与依赖图一致可避免部分 IDE 先入为主解析 web 却无本地构件 -->
        <module>store-cloud-core-logging</module>
        <module>store-cloud-core-response</module>
        <module>store-cloud-core-auth</module>
        <module>store-cloud-core-web</module>
    </modules>
</project>
